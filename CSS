body{
margin:0;
font-family:Arial,sans-serif;
background:#f5f5f5;
}

header{
background:#17007a;
color:white;
padding:15px 20px;
display:flex;
justify-content:space-between;
align-items:center;
font-weight:bold;
position:sticky;
top:0;
z-index:1000;
}

.hero{
height:550px;
background:url('https://upload.wikimedia.org/wikipedia/commons/6/6e/Jagannath_Temple%2C_Puri.jpg') center/cover;
display:flex;
align-items:center;
justify-content:center;
text-align:center;
}

.overlay{
background:rgba(0,0,0,0.6);
padding:40px;
border-radius:20px;
color:white;
}

.overlay h1{
font-size:60px;
margin:0;
}

.overlay p{
font-size:22px;
margin:15px 0;
}

.btn{
display:inline-block;
background:#ff008c;
padding:12px 25px;
margin:10px;
color:white;
text-decoration:none;
border-radius:30px;
font-weight:bold;
}

.whatsapp{
background:#00b33c;
}

.packages,.cars,.places,.contact{
padding:60px 20px;
text-align:center;
}

.package-grid,.car-grid,.place-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:20px;
margin-top:30px;
}

.card{
padding:25px;
border-radius:20px;
color:white;
font-weight:bold;
box-shadow:0 5px 15px rgba(0,0,0,0.2);
}

.blue{background:#0066ff;}
.orange{background:#ff6600;}
.pink{background:#ff008c;}
.green{background:#00a651;}

.car-card,.place{
background:white;
padding:15px;
border-radius:20px;
box-shadow:0 5px 15px rgba(0,0,0,0.15);
}

.car-card img,.place img{
width:100%;
height:220px;
object-fit:cover;
border-radius:15px;
}

.contact{
background:#17007a;
color:white;
}

footer{
background:black;
color:white;
padding:15px;
text-align:center;
}
